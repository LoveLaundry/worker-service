# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
# DATABASE_URL=mongodb://localhost:27017
# DATABASE_URL=sqlite:///./workers.db

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_DB_NAME=workers_db
MONGODB_WORKERS_COLLECTION=workers
MONGODB_DAILY_LOGS_COLLECTION=daily_task_logs

# ─── Three-database architecture (optional) ──────────────────────────────────
# MAIN      — production source of truth (defaults to DATABASE_URL)
# SECONDARY — verification/replica DB written by the sync worker
# LOCAL     — admin-triggered replica; never a read source for the API
# MONGODB_MAIN_URI=
# MONGODB_MAIN_DB=
# MONGODB_SECONDARY_URI=
# MONGODB_SECONDARY_DB=
# MONGODB_LOCAL_URI=
# MONGODB_LOCAL_DB=

# ─── JWT (must be identical across all services) ─────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Encryption (must be identical across all services) ──────────────────────
MASTER_KEY=change-me-in-production

# ─── CORS / Observability ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
# SENTRY_DSN=
